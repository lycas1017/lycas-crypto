# forex-bot secrets. Keep this file private and out of git.

# OANDA API access. A free practice (demo) account works for data and practice trading:
# sign up at oanda.com, then My Account > Manage API Access to create a token.
# The account id looks like 101-004-1234567-001.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice = demo money, live = real money
OANDA_ENVIRONMENT=practice

# Safety switch: "forex-bot live" refuses to start unless this is true.
LIVE_TRADING=false

# Optional Telegram notifications: create a bot with @BotFather, message it once,
# then find your chat id with @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
